    "/heater/fan/mode/{mode}": {
      "post": {
        "operationId": "HeaterController_setFanMode",
        "summary": "",
        "description": "Sets the fan mode to \"auto\" (default) or \"manual\". If you set to \"manual\" you can adjust the fan speed using the \"fan/speed\" endpoint. \n Please BE AWARE that if the heater reaches HOT or DANGEROUS temperature levels, the fan speed is overwritten regardless if mode is \"auto\" or \"manual\". This is dangerous and will damage your heater if you are not careful. \n Deprecated for Ofen 2 (Does nothing)",
        "deprecated": true,
        "parameters": [
          {
            "name": "mode",
            "required": true,
            "description": "The fan operation mode: \"auto\" or \"manual\"",
            "in": "path",
            "schema": {
              "example": "auto",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Indicates whether the operation was successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        },
        "tags": [
          "Heater"
        ]
      }
    },
    "/heater/fan/{speed}": {
      "post": {
        "operationId": "HeaterController_setFanSpeed",
        "summary": "",
        "description": "Manually overwrites the fan speed. If the mode is set to \"auto\" (default) the speed will be adjusted automatically. If you want to set the fan speed permanent, please set the mode to \"manual\" first. Deprecated for Ofen 2 (Does nothing)",
        "deprecated": true,
        "parameters": [
          {
            "name": "speed",
            "required": true,
            "description": "The speed of the fan: 0 (off) - 100 (full speed)",
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "Heater"
        ]
      }
    },
    "/heater/powerTarget/{index}": {
      "post": {
        "operationId": "HeaterController_setPowerTarget",
        "summary": "",
        "description": "Switch to other power target level. Index must be a value between 0 and 4.",
        "parameters": [
          {
            "name": "index",
            "required": true,
            "description": "The level for the new power target. Must be between 0 and 4, inclusive!",
            "in": "path",
            "schema": {
              "minimum": 0,
              "maximum": 4,
              "example": 2,
              "type": "number"
            }
          },
          {
            "name": "notifyApp",
            "required": false,
            "in": "query",
            "description": "Whether the app should be notified in real time about this change",
            "schema": {
              "default": true,
              "type": "boolean"
