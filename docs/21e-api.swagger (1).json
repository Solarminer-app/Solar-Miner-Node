    "/heater/scheduledHeating": {
      "get": {
        "operationId": "HeaterController_getAllSchedules",
        "summary": "Retrieve all scheduled heating options",
        "description": "Returns an array of all currently defined heating schedules.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successfully retrieved all scheduled heating options.",
            "schema": {
              "example": [
                {
                  "id": "98e6a7a0-bd32-4797-b440-9014249bf7a0",
                  "repeat": true,
                  "days": 62,
                  "startTime": "08:00",
                  "endTime": "10:30",
                  "heatingLevel": 3,
                  "active": true
                },
                {
                  "id": "0e6bdd3b-0814-4dc6-8524-baf7bd14d217",
                  "repeat": false,
                  "days": 127,
                  "startTime": "18:00",
                  "endTime": "20:00",
                  "heatingLevel": 2,
                  "active": false
                }
              ]
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScheduledHeatingResponseDto"
                  }
                }
              }
            }
          },
          "204": {
            "description": "No schedules found (empty array returned).",
            "content": {
              "application/json": {
                "schema": {
                  "example": []
                }
              }
            }
          },
          "500": {
            "description": "An error occurred while retrieving schedules."
          }
        },
        "tags": [
          "Heater"
        ]
      },
      "post": {
        "operationId": "HeaterController_setScheduledHeating",
        "summary": "",
        "description": "Add a scheuled heating action",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "add a scheduled heating action",
          "content": {
