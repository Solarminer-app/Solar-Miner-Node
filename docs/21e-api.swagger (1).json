    "/heater/scheduledHeating/{id}": {
      "delete": {
        "operationId": "HeaterController_deleteSchedule",
        "summary": "",
        "description": "Delete a scheduled heating option by ID",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "description": "ID of the scheduled heating that should be deleted",
            "in": "path",
            "schema": {
              "example": "98e6a7a0-bd32-4797-b440-9014249bf7a0",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Indicates whether the operation was successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        },
        "tags": [
          "Heater"
        ]
      },
      "put": {
        "operationId": "HeaterController_updateSchedule",
        "summary": "",
        "description": "toggle a schedule make it active/inactive",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "description": "ID of the schduler that needs to be modified",
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "active boolean field",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BodyUpdateScheduledHeatingDto"
              },
              "examples": {
                "default": {
                  "summary": "Enable or disable schedule",
                  "value": {
                    "active": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scheduled heating option updated successfully."
          },
          "400": {
            "description": "Invalid input data or unknown ID"
          },
          "404": {
            "description": "Scheduled heating option with the given ID not found."
          },
          "500": {
            "description": "An unexpected error occurred while updating the schedule."
          }
        },
        "tags": [
          "Heater"
        ]
      }
    },
