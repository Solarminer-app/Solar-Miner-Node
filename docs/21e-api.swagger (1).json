    "/status": {
      "get": {
        "operationId": "StatusController_status",
        "summary": "Health Check",
        "description": "Returns the operational status of the API service. Use this endpoint to verify that the service is running and accepting requests.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is operational and ready to handle requests",
            "schema": {
              "example": {
                "operational": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Status"
        ]
      }
    },
    "/status/version": {
      "get": {
        "operationId": "StatusController_version",
        "summary": "Get API Version",
        "description": "Returns the current version of the 21control API service.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current version of the API service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "2.1.4"
                }
              }
            }
          }
        },
        "tags": [
          "Status"
        ]
      }
    },
    "/status/system": {
      "get": {
        "operationId": "StatusController_systemSummary",
